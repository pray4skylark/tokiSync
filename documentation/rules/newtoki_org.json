[
  {
    "id": "newtoki_org_novel",
    "name": "뉴토끼 소설",
    "urlPattern": "https://newtoki[0-9]+\\.org/novel/.*",
    "category": "Novel",
    "meta": {
      "title": "div.row > div.col-sm-8 > div.theme-detail-title-line",
      "author": "div.theme-detail-info-row > span.theme-detail-info-value > a",
      "thumb": {
        "selector": "div.view-content1 > div.view-img > img",
        "attr": "src"
      }
    },
    "list": {
      "container": "ul.list-body",
      "item": "li.list-item",
      "num": "div.wr-num",
      "title": "a.item-subject",
      "link": {
        "selector": "a.item-subject",
        "attr": "href"
      }
    },
    "viewer": {
      "fetchMethod": "api",
      "imageRegex": "https?:\\\\/\\\\/[a-zA-Z0-9_\\\\.\\\\/-]+\\\\.(?:jpg|png|webp|gif)",
      "imageContainer": "div.theme-novel-content",
      "imageItem": "p",
      "lazyAttrOptions": []
    },
    "_version": "1.28.1"
  },
